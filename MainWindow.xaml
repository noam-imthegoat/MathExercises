<Window x:Class="MathExercises.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MathExercises"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"/>
            <RowDefinition Height="0.35*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.35*"/>
            <RowDefinition Height="0.35*"/>

        </Grid.RowDefinitions>

        <TextBlock x:Name="welcomeText" Text="!ברוכים הבאים" FontSize="50" Grid.Column="1" 
                   Grid.Row="1" HorizontalAlignment="Center"/>
        <Button x:Name="startButton" Content="התחל" Grid.Column="1" Grid.Row="2" FontSize="60" 
                Width="300" Height="100" Background="LightBlue" Click="startButton_Click"/>

        <StackPanel x:Name="mainScreen" Orientation="Horizontal" Grid.Column="1" Grid.Row="2">
            <Rectangle Width="25" Height="50"/>
            <TextBlock x:Name="randomNum1" Text="num" FontSize="20" Width="50" Height="50" TextAlignment="Center"/>
            <Rectangle Width="25" Height="50"/>
            <TextBlock x:Name="sign" Text="act" FontSize="20" Width="50" Height="50" TextAlignment="Center" />
            <Rectangle Width="25" Height="50"/>
            <TextBlock x:Name="randomNum2" Text="num" FontSize="20" Width="50" Height="50" TextAlignment="Center"/>
            <Rectangle Width="25" Height="50"/>
            <TextBlock x:Name="Equals" Text="=" FontSize="20" Width="50" Height="50" TextAlignment="Center"/>
            <Rectangle Width="25" Height="50"/>
            <TextBox x:Name="Answer" FontSize="20" Width="50" Height="50" TextAlignment="Center"/>
            <Rectangle Width="25" Height="50"/>
        </StackPanel>
        
        <TextBlock x:Name="exerciseText" Text="תרגיל מספר" FontSize="50" Grid.Column="1" 
           Grid.Row="0" HorizontalAlignment="Center"/>
        <TextBlock x:Name="exerciseNum" Text="0" FontSize="50" Grid.Column="1" 
            Grid.Row="1" HorizontalAlignment="Center"/>

        <Button x:Name="checkButton" Content="בדיקה" Grid.Column="2" Grid.Row="2" FontSize="20" Width="75" 
                Height="75" Background="LightBlue" Click="checkButton_Click"/>
        <TextBlock x:Name="isCorrect" Text="BOOL" TextAlignment="Center" FontSize="40" Grid.Column="1" Grid.Row="3" Visibility="Collapsed"/>
        <Button x:Name="contButton" Grid.Column="1" Grid.Row="4" Height="40" Width="200" Content="המשך" Click="contButton_Click"/>
        <Button x:Name="restart" Grid.Column="1" Grid.Row="4" Height="40" Width="200" Content="התחל מחדש" Click="restart_Click" Visibility="Collapsed" />

        <TextBlock x:Name="grade" Text="הציון" TextAlignment="Center" FontSize="50" FontWeight="Bold" Grid.Column="1" Grid.Row="2" Visibility="Collapsed"/>
    </Grid>
</Window>
